generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  STAFF
}

enum Modality {
  IN_PERSON
  ONLINE
}

enum EnrollmentStatus {
  REGISTERED
  COMPLETED
  CANCELLED
}

enum Stage {
  UNO
  DOS
  TRES
}

enum CourseType {
  CURSO
  TALLER
  CONFERENCIA
}

enum BackgroundPattern {
  GRID
  WAVES
  SHAPES
  CARDS
  SLIDES
  GROWTH
  CHAT
}

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  hashedPassword String
  role           Role         @default(USER)
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
}

model Course {
  id                String              @id @default(uuid())
  slug              String              @unique
  title             String
  shortDescription  String
  description       String
  image             String
  icon              String?
  video             String?
  color             String
  type              CourseType
  stage             Stage
  categories        String[]
  skills            String[]
  duration          String
  sessions          Int?
  hoursPerSession   Int?
  modality          String
  participants      String
  targetAudience    String
  objective         String
  requirements      String
  backgroundPattern BackgroundPattern
  featured          Boolean             @default(false)
  featuredOrder     Int?
  clickable         Boolean             @default(true)
  isActive          Boolean             @default(true)
  testimonials      CourseTestimonial[]
  enrollments       Enrollment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([slug])
  @@index([featured, featuredOrder])
}

model CourseTestimonial {
  id       String  @id @default(uuid())
  message  String
  name     String
  role     String
  avatar   String?
  rating   Int?
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Event {
  id           String       @id @default(uuid())
  title        String
  description  String
  image        String
  date         DateTime
  time         String?
  modality     Modality
  category     String       @default("general")
  profile      String?
  objective    String?
  duration     String?
  participants String?
  requirements String?
  location     String?
  address      String?
  platform     String?
  isActive     Boolean      @default(true)
  enrollments  Enrollment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([date])
}

model Enrollment {
  id        String           @id @default(uuid())
  status    EnrollmentStatus @default(REGISTERED)
  date      DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  eventId   String?
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  isArchived Boolean @default(false)
  isSpam     Boolean @default(false)
  date      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  replies ContactReply[]

  @@index([isSpam, isArchived, lastActivityAt, id])
}


enum ContactReplyStatus {
  PENDING
  SENT
  FAILED
}

model ContactReply {
  id          String @id @default(uuid())
  messageId   String
  message     ContactMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  staffId     String?
  staffName   String
  fromEmail   String
  toEmail     String
  replyTo     String
  subject     String
  body        String
  status      ContactReplyStatus @default(PENDING)
  providerId  String?
  provider    String @default("resend")
  direction   String @default("OUTBOUND")
  providerThreadId String?
  rfcMessageId String?
  gmailDraftId String?
  gmailSendLeaseUntil DateTime?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sentAt      DateTime?

  @@index([messageId, createdAt, id])
  @@index([provider, providerThreadId])
  @@unique([provider, providerId])
}


model ContactMailbox {
  id String @id @default("institution")
  email String
  encryptedRefreshToken String
  connectedBy String
  historyId String?
  nextPageToken String?
  recoveryCursor String?
  recoveryHistoryId String?
  leaseUntil DateTime?
  lastSyncedAt DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}
