# ==========================================
# Maestro Virtual - Environment Variables
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=
# Remitente para respuestas normales del staff a usuarios desde el Admin Panel (dominio verificado en Resend).
# Ejemplo: "Soporte Maestro Virtual <soporte@maestrovirtual.org>"
MAIL_FROM=
# Remitente para notificaciones escaladas a TI desde el Admin Panel (dominio verificado en Resend).
# Ejemplo: "Sistema Maestro Virtual <importante@maestrovirtual.org>"
MAIL_FROM_NOTIFICATIONS=
# Buzón que recibirá las contestaciones. Por defecto CONTACT_EMAIL.
MAIL_REPLY_TO=
# Correo al que el staff reenvía mensajes importantes desde el panel admin.
# Por defecto CONTACT_EMAIL. Cuando exista un correo propio de Maestro Virtual,
# solo cambia este valor.
FORWARD_TO_EMAIL=

# Database
DATABASE_URL= postgresql://usuario:[TU-PASSWORD]@servidor
# Conexión directa para aplicar migraciones (misma base que DATABASE_URL).
DIRECT_URL=

# Authentication
NEXTAUTH_SECRET= 
# Firma la sesion del staff (MV-33). Minimo 32 caracteres. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL= https://[TU-PASSWORD].supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY= [TU-PASSWORD]

# Proveedor para respuestas del panel: resend o gmail.
MAIL_PROVIDER=resend
# Gmail API: cliente OAuth web. Nunca se guardan contraseñas de Gmail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCOUNT_EMAIL=maestrovirtualorg@gmail.com
# Debe coincidir exactamente con la URI autorizada en Google Cloud.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/mailbox/gmail/callback
# Opcional, 32+ caracteres para cifrar tokens. Si falta se usa AUTH_SECRET.
GMAIL_TOKEN_SECRET=
